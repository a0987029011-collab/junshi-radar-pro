{
  "name": "junshi-radar-pro",
  "version": "0.8.1",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "data:refresh": "node --env-file-if-exists=.env.local scripts/fetch-market-snapshot.mjs && node --experimental-strip-types scripts/build-signal-research-payload.ts",
    "data:seed": "node scripts/fetch-market-snapshot.mjs --from-existing && node --experimental-strip-types scripts/build-signal-research-payload.ts",
    "data:research": "node --experimental-strip-types scripts/build-signal-research-payload.ts",
    "data:taishin-check": "node --env-file-if-exists=.env.local scripts/check-taishin-nova.mjs",
    "data:taishin-register": "node --env-file-if-exists=.env.local scripts/check-taishin-nova.mjs --register",
    "automation:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/automation/install-windows-tasks.ps1",
    "automation:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/automation/update-market-data.ps1",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "dev:sites": "vinext dev",
    "build:sites": "vinext build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .local",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
